# =============================================================================
# isc-auth-gate — Environment Variables
# Copy to .env and fill in your values.
# =============================================================================

# ------- Server -------
BETTER_AUTH_SERVER_NAME=isc-auth-server
BETTER_AUTH_SERVER_HOST=0.0.0.0
BETTER_AUTH_SERVER_PORT=4000
BETTER_AUTH_SERVER_DEBUG=true
BETTER_AUTH_SERVER_SECRET=change-me-to-a-random-string
# Comma-separated list of allowed origins
BETTER_AUTH_SERVER_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001
# client_ids de primera parte (trusted) — inmutables vía CRUD del plugin.
# Espejo en NEXT_PUBLIC para que el dashboard muestre el badge "Trusted".
BETTER_AUTH_OAUTH_TRUSTED_CLIENTS=isc-gate-dashboard
NEXT_PUBLIC_BETTER_AUTH_OAUTH_TRUSTED_CLIENTS=isc-gate-dashboard
# Opcional — seed inicial de resources (RFC 8707), insertOnly (no pisa DB).
# Fuente de verdad: tabla oauth_resources gestionada desde dashboard admin.
# JSON array de {identifier, name, allowedScopes}. Vacío por defecto.
# BETTER_AUTH_OAUTH_RESOURCES=[{"identifier":"https://api.example.com","name":"API","allowedScopes":["user:read"]}]
# Scopes propios además de openid/profile/email/offline_access (separados por comas)
# BETTER_AUTH_OAUTH_SCOPES=todo:read,todo:write,organization  # "organization" = rol y permisos por organización en el token

# ------- Better Auth URLs -------
BETTER_AUTH_URL=http://localhost:3000/
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# ------- Microsoft Entra ID (OAuth) -------
BETTER_AUTH_MICROSOFT_PROMPT=select_account
BETTER_AUTH_MICROSOFT_AUTHORITY=https://login.microsoftonline.com/
BETTER_AUTH_MICROSOFT_TENANT_ID=
BETTER_AUTH_MICROSOFT_CLIENT_ID=
BETTER_AUTH_MICROSOFT_CLIENT_SECRET=
BETTER_AUTH_MICROSOFT_PROFILE_PHOTO_SIZE=648
BETTER_AUTH_MICROSOFT_OVERRIDE_USER_INFO_ON_SIGN_IN=true

# ------- PostgreSQL -------
BETTER_AUTH_DATABASE_HOST=localhost
BETTER_AUTH_DATABASE_NAME=isc-auth-dev
BETTER_AUTH_DATABASE_PORT=5432
BETTER_AUTH_DATABASE_USER=
BETTER_AUTH_DATABASE_PASS=
BETTER_AUTH_DATABASE_SSL=false
BETTER_AUTH_DATABASE_DEBUG=false
# ⚠️ Los tests comparten la DB de dev y cleanupTestDb() hace TRUNCATE.
# Deja esto en false para proteger tus datos (los tests fallarán con un error
# claro en vez de vaciar la DB). Ponlo en true SOLO si aceptas el wipe.
BETTER_AUTH_TEST_ALLOW_TRUNCATE=false

# ------- SMTP -------
# SECURE=true es TLS implícito (solo 465). Con 587/1025 STARTTLS va false.
BETTER_AUTH_SMTP_TRANSPORTER_HOST=smtp.office365.com
BETTER_AUTH_SMTP_TRANSPORTER_PORT=587
BETTER_AUTH_SMTP_TRANSPORTER_SECURE=false
BETTER_AUTH_SMTP_TRANSPORTER_USER=
BETTER_AUTH_SMTP_TRANSPORTER_PASS=

# ------- Telemetría del SDK de email -------
# @opencoredev/email-sdk manda métricas anónimas (adapter, comando, éxito/fallo).
# 0 lo desactiva (alternativa: DO_NOT_TRACK=1).
EMAIL_SDK_TELEMETRY=0
